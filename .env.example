# Copy this file to .env and replace the values you need.
# Never commit .env or real API keys.

# ── Telegram ──────────────────────────────────────────────────────────
BOT_TOKEN=replace_with_telegram_bot_token
BOT_USERNAME=your_bot_username
ADMIN_IDS=

# ── Database ──────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./memorabot.db

# ── AI mode ───────────────────────────────────────────────────────────
# gateway = multi-key Gemini/Groq routing (recommended)
# gemini / groq = legacy single-provider mnemonic mode
# mock = deterministic demo provider
AI_PROVIDER=gateway

# Gateway key pools: comma-separated REAL keys. Leave unused pools empty.
# Do not leave example placeholder strings here: the gateway treats each
# non-empty comma-separated value as a configured key.
FREE_GEMINI_KEYS=
PREMIUM_GEMINI_KEYS=
FREE_GROQ_KEYS=
PREMIUM_GROQ_KEYS=

# Legacy single-provider keys (only used with AI_PROVIDER=gemini or groq)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Mnemonic knowledge base version. v1, v2, and v3 are included.
MNEMONIC_PROMPT_VERSION=v3

# ── AI Gateway routing ────────────────────────────────────────────────
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
GROQ_MODELS=llama-3.3-70b-versatile,qwen-qwq-32b,deepseek-r1-distill-llama-70b
GATEWAY_PROVIDER_PRIORITY=gemini,groq
GATEWAY_FAILURE_THRESHOLD=3
GATEWAY_RECOVERY_SECONDS=300
GATEWAY_REQUEST_TIMEOUT=30
GATEWAY_RETRY_COUNT=1
GATEWAY_LOAD_BALANCER=round_robin

# ── MneVoca free plan ─────────────────────────────────────────────────
# Number of fresh (non-cached) MneVoca generations per rolling 24-hour window.
FREE_PLAN_DAILY_GENERATIONS=3

# ── Quiz ──────────────────────────────────────────────────────────────
QUIZ_OPEN_PERIOD=20
QUIZ_VOCABULARY_QUESTIONS=5
GRAMMAR_QUIZ_QUESTIONS=5
GRAMMAR_QUIZ_TIME_SECONDS=20

# ── Grammar channel ───────────────────────────────────────────────────
# Use 0 until a channel is configured; otherwise use the numeric channel ID.
GRAMMAR_CHANNEL_ID=0

# ── Logging and broadcast ──────────────────────────────────────────────
LOG_LEVEL=INFO
BROADCAST_DELAY_MS=50

# ── Referral and coin economy ──────────────────────────────────────────
REFERRAL_BASE_REWARD=20
REFERRAL_INCREMENT=2
REFERRAL_MAX_REWARD=100
PREMIUM_DAILY_COST=100
WELCOME_REFERRAL_BONUS=0
TOP_REFERRERS_LIMIT=10
