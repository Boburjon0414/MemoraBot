```env
# Copy this file to .env and fill in your own values:
#   cp .env.example .env

# ── Telegram ──────────────────────────────────────────────────────────
BOT_TOKEN=your_telegram_bot_token_here

# ── Database ──────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./memorabot.db

# ── AI Provider ───────────────────────────────────────────────────────
# Available modes: "gateway", "gemini", "groq", "mock"
AI_PROVIDER=gateway

# ── Gemini ────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Which app/knowledge/<x>/ folder to use.
# Bump this and add a new version folder to try a new knowledge base
# without touching any code.
MNEMONIC_PROMPT_VERSION=v3

# ── Free plan ─────────────────────────────────────────────────────────
# Maximum number of genuinely NEW AI-generated words a free user
# can request. Cached words are free and do not count against this limit.
FREE_PLAN_GENERATION_LIMIT=999

# ── MneVoca ───────────────────────────────────────────────────────────
# Maximum number of words accepted per single batch request.
MNEVOCA_LIMIT=10

# ── Logging ───────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Admins ────────────────────────────────────────────────────────────
# Comma-separated Telegram user IDs.
ADMIN_IDS=your_telegram_user_id_here

# ── Broadcast ─────────────────────────────────────────────────────────
# Delay between messages in milliseconds.
BROADCAST_DELAY_MS=50

# ── Referral & Coin Economy ───────────────────────────────────────────
# Coin reward for Friend #1. Each subsequent referral earns
# REFERRAL_INCREMENT more, up to REFERRAL_MAX_REWARD.
REFERRAL_BASE_REWARD=20
REFERRAL_INCREMENT=2
REFERRAL_MAX_REWARD=100

# Coin cost for 1 day of Premium.
PREMIUM_DAILY_COST=100

# Bonus coins given to a new user joining via a referral link.
# Set to 0 to disable.
WELCOME_REFERRAL_BONUS=10

# Number of entries shown in Top Referrers / Top Coin Holders lists.
TOP_REFERRERS_LIMIT=10

# Your bot's @username WITHOUT the @ sign.
BOT_USERNAME=your_bot_username

# ── AI Gateway ────────────────────────────────────────────────────────
# Gateway enables multi-key, multi-provider routing.

# Free Gemini keys for non-premium users.
# Add multiple comma-separated keys if needed.
FREE_GEMINI_KEYS=your_gemini_free_key_1,your_gemini_free_key_2

# Premium Gemini keys.
PREMIUM_GEMINI_KEYS=your_gemini_premium_key_1,your_gemini_premium_key_2

# Free Groq keys for non-premium users.
FREE_GROQ_KEYS=your_groq_free_key_1,your_groq_free_key_2

# Premium Groq keys.
PREMIUM_GROQ_KEYS=your_groq_premium_key_1,your_groq_premium_key_2

# Models to try per provider, in order.
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
GROQ_MODELS=llama-3.3-70b-versatile,qwen-qwq-32b,deepseek-r1-distill-llama-70b

# Provider try-order.
# The first provider is primary; the next is automatic fallback.
GATEWAY_PROVIDER_PRIORITY=gemini,groq

# ── Gateway health & routing ──────────────────────────────────────────
# Consecutive failures before automatic cooldown.
GATEWAY_FAILURE_THRESHOLD=3

# Seconds before a cooled-down key is retried.
GATEWAY_RECOVERY_SECONDS=300

# HTTP timeout per request in seconds.
GATEWAY_REQUEST_TIMEOUT=30

# Number of transient-error retries before rotating to another key.
GATEWAY_RETRY_COUNT=1

# Load balancing strategy.
GATEWAY_LOAD_BALANCER=round_robin

# ── Legacy single-provider Groq mode ──────────────────────────────────
# Used when AI_PROVIDER=groq.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ── Grammar ───────────────────────────────────────────────────────────
GRAMMAR_CHANNEL_ID=your_telegram_channel_id_here
```